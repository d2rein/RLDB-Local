{
  "name": "rugby-league-stats-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "local:start": "wrangler dev --env local --local --ip 127.0.0.1 --port 8787",
    "local:serve": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-local-site.ps1",
    "local:backend": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-local-site.ps1 -Port 8797",
    "local:watchdog": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-hybrid-watchdog-hidden.ps1",
    "local:stop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stop-hybrid-backend.ps1 -IncludeTunnel -IncludeWatchdog",
    "local:auth-attempts": "powershell -ExecutionPolicy Bypass -File .\\scripts\\show-auth-attempts.ps1",
    "local:active-users": "powershell -ExecutionPolicy Bypass -File .\\scripts\\show-active-users.ps1",
    "telemetry:start": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-query-telemetry-hidden.ps1",
    "telemetry:serve": "node ./scripts/query-telemetry-server.mjs",
    "telemetry:report": "node ./scripts/report-query-telemetry.mjs",
    "telemetry:version": "node ./scripts/runtime-version.mjs",
    "telemetry:test": "node ./scripts/run-query-telemetry-tests.mjs",
    "benchmark:capture": "node ./scripts/run-query-benchmark.mjs --capture-baseline",
    "benchmark:run": "node ./scripts/run-query-benchmark.mjs",
    "benchmark:stage3": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stage3\\run-stage3-benchmark.ps1",
    "benchmark:snapshot": "node ./scripts/create-benchmark-snapshot.mjs",
    "local:refresh": "powershell -ExecutionPolicy Bypass -File .\\scripts\\refresh-local-data.ps1",
    "local:refresh:hybrid": "powershell -ExecutionPolicy Bypass -File .\\scripts\\refresh-hybrid-site.ps1",
    "auth:hash-password": "node ./scripts/hash-site-password.mjs",
    "deploy": "wrangler deploy --env \"\"",
    "db:migrate:local": "wrangler d1 migrations apply rl_stats_db --env local --local",
    "db:migrate:remote": "wrangler d1 migrations apply rl_stats_db --remote",
    "players:reconcile": "node ./scripts/build-player-reconciliation.mjs",
    "players:review": "node ./scripts/build-player-review-files.mjs",
    "players:overrides": "node ./scripts/export-player-alias-overrides.mjs",
    "rep:discover-origin": "node ./scripts/discover-origin-match-centres.mjs",
    "rep:fetch-origin-payloads": "node ./scripts/fetch-origin-raw-payloads.mjs",
    "rep:fetch-origin-afltables": "node ./scripts/fetch-origin-afltables-supplement.mjs",
    "rep:build-structured": "node ./scripts/build-rep-structured-data.mjs",
    "rep:audit": "node ./scripts/audit-rep-structured-data.mjs",
    "matches:sync-nrl-backbone": "node ./scripts/sync-nrl-match-backbone.mjs --season=2026",
    "seed:current-season-refresh": "node ./scripts/build-current-season-refresh-sql.mjs --season=2026",
    "seed:reference": "node ./scripts/build-reference-seed.mjs",
    "seed:core": "node ./scripts/build-core-import-bundle.mjs",
    "seed:core-sql": "node ./scripts/build-core-seed-sql.mjs",
    "seed:legacy-sql": "node ./scripts/build-legacy-scoring-seed-sql.mjs",
    "seed:player-stats-sql": "node ./scripts/build-player-stat-aggregate-seed-sql.mjs",
    "seed:match-summaries-sql": "node ./scripts/build-match-summary-seed-sql.mjs",
    "db:rebuild:player-aggregates": "node ./scripts/rebuild-player-stat-aggregates-from-summaries.mjs --operational",
    "db:verify:player-aggregates": "node ./scripts/verify-player-stat-aggregates.mjs",
    "review:legacy-unresolved-scorers": "node ./scripts/export-unresolved-legacy-scorer-review.mjs",
    "review:long-careers": "node ./scripts/audit-long-careers.mjs",
    "review:long-career-splits": "node ./scripts/build-long-career-split-definitions.mjs",
    "review:stat-anomalies": "node ./scripts/build-stat-anomaly-review.mjs",
    "audit:repeated-finals": "node ./scripts/audit-repeated-finals.mjs",
    "db:seed:local-sqlite": "node ./scripts/apply-local-d1-sqlite.mjs",
    "db:seed:remote": "node --max-old-space-size=4096 ./scripts/apply-remote-d1.mjs",
    "db:seed:remote:match-summaries": "node --max-old-space-size=4096 ./scripts/apply-remote-d1.mjs --start-at 0005_match_summaries_seed.sql --max-chunk-bytes 8388608",
    "db:seed:remote:match-summaries:batch": "node --max-old-space-size=4096 ./scripts/apply-remote-d1.mjs --only-file 0005_match_summaries_seed.sql --max-chunks 100 --resume 1 --allow-full-reseed 1 --max-chunk-bytes 8388608 --heartbeat-ms 10000"
  },
  "devDependencies": {
    "wrangler": "^4.11.1"
  }
}
